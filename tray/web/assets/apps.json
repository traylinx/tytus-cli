  {
    "id": "openwork",
    "name": "OpenWork",
    "description": "Open-source desktop workspace for agentic AI \u2014 run AI agents locally with a native UI. An open alternative to Claude's Cowork.",
    "category": "AI & ML",
    "icon": "Bot",
    "url": "https://openworklabs.com",
    "docs": "https://github.com/different-ai/openwork",
    "platforms": [
      "macos",
      "linux",
      "windows"
    ],
    "detect": {
      "macos": [
        "OpenWork"
      ],
      "linux": [
        "openwork"
      ],
      "windows": [
        "OpenWork"
      ]
    },
    "install": {
      "macos": "On Intel Mac, Tytus builds OpenWork locally from source because the published x64 DMG currently contains ARM64 native modules. Apple Silicon uses the official release.",
      "linux": "Tytus selects the matching OpenWork Linux release automatically (x64 or ARM64).",
      "windows": "Tytus selects the matching OpenWork Windows x64 release automatically. Windows ARM64 is not supported yet."
    },
    "launch": {
      "macos": {
        "kind": "app",
        "target": "OpenWork"
      },
      "linux": {
        "kind": "app",
        "target": "openwork"
      },
      "windows": {
        "kind": "app",
        "target": "OpenWork"
      }
    },
    "llm_setup": {
      "adapter": "opencode",
      "provider": "tytus-ail",
      "default_model": "ail-compound",
      "supports_default": true
    },
    "installers": [
      {
        "os": "macos",
        "arch": "x64",
        "kind": "openwork_source_build_macos",
        "label": "Build OpenWork locally for Intel Mac",
        "repo": "different-ai/openwork"
      },
      {
        "os": "macos",
        "arch": "arm64",
        "kind": "github_release_dmg",
        "label": "Install OpenWork for Apple Silicon",
        "repo": "different-ai/openwork",
        "asset_regex": "^openwork-mac-arm64-[0-9]+\\.[0-9]+\\.[0-9]+\\.dmg$"
      },
      {
        "os": "windows",
        "arch": "x64",
        "kind": "github_release_exe",
        "label": "Install OpenWork for Windows x64",
        "repo": "different-ai/openwork",
        "asset_regex": "^openwork-win-x64-[0-9]+\\.[0-9]+\\.[0-9]+\\.exe$"
      },
      {
        "os": "windows",
        "arch": "arm64",
        "kind": "github_release_exe",
        "label": "Windows ARM64 unsupported",
        "repo": "different-ai/openwork",
        "asset_regex": "^$",
        "disabled": true,
        "disabled_reason": "OpenWork Windows ARM64 support is not evidenced by current release assets. Use Windows x64, macOS, or Linux builds."
      },
      {
        "os": "linux",
        "arch": "x64",
        "kind": "github_release_appimage",
        "label": "Install OpenWork for Linux x64",
        "repo": "different-ai/openwork",
        "asset_regex": "^openwork-linux-x86_64-[0-9]+\\.[0-9]+\\.[0-9]+\\.AppImage$"
      },
      {
        "os": "linux",
        "arch": "arm64",
        "kind": "github_release_appimage",
        "label": "Install OpenWork for Linux ARM64",
        "repo": "different-ai/openwork",
        "asset_regex": "^openwork-linux-arm64-[0-9]+\\.[0-9]+\\.[0-9]+\\.AppImage$"
      }
    ]
  },
