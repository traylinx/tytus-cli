      },
      {
        "os": "linux",
        "arch": "x64",
        "package_manager": "apt",
        "kind": "command",
        "label": "Install with apt for Linux x64",
        "command": "sudo apt-get install wget gpg && wget -qO- https://releases.warp.dev/linux/keys/warp.asc | gpg --dearmor > warpdotdev.gpg && sudo install -D -o root -g root -m 644 warpdotdev.gpg /etc/apt/keyrings/warpdotdev.gpg && sudo sh -c 'echo \"deb [arch=amd64 signed-by=/etc/apt/keyrings/warpdotdev.gpg] https://releases.warp.dev/linux/deb stable main\" > /etc/apt/sources.list.d/warpdotdev.list' && rm warpdotdev.gpg && sudo apt update && sudo apt install warp-terminal"
      },
