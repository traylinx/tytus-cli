[
  {
    "id": "opencode",
    "name": "OpenCode",
    "description": "AI-powered code editor and terminal assistant. Built for developers who want AI pair programming in their terminal.",
    "category": "Developer Tools",
    "icon": "Terminal",
    "url": "https://opencode.ai/",
    "docs": "https://opencode.ai/docs/",
    "platforms": [
      "macos",
      "linux",
      "windows"
    ],
    "detect": {
      "macos": [
        "opencode"
      ],
      "linux": [
        "opencode"
      ],
      "windows": [
        "opencode"
      ]
    },
    "install": {
      "macos": "brew install anomalyco/tap/opencode",
      "linux": "curl -fsSL https://opencode.ai/install.sh | sh",
      "windows": "Visit https://opencode.ai/docs for Windows installation instructions"
    },
    "launch": {
      "macos": {
        "kind": "terminal",
        "target": "opencode"
      },
      "linux": {
        "kind": "terminal",
        "target": "opencode"
      },
      "windows": {
        "kind": "terminal",
        "target": "opencode"
      }
    },
    "llm_setup": {
      "adapter": "opencode",
      "provider": "tytus-ail",
      "default_model": "ail-compound",
      "supports_default": true
    },
    "installers": [
      {
        "os": "macos",
        "arch": "universal",
        "package_manager": "brew",
        "kind": "command",
        "label": "Install for this Mac",
        "command": "brew install anomalyco/tap/opencode"
      },
      {
        "os": "linux",
        "arch": "x64",
        "kind": "command",
        "label": "Install for Linux x64",
        "command": "curl -fsSL https://opencode.ai/install | bash"
      },
      {
        "os": "linux",
        "arch": "arm64",
        "kind": "command",
        "label": "Install for Linux ARM64",
        "command": "curl -fsSL https://opencode.ai/install | bash"
      },
      {
        "os": "windows",
        "arch": "x64",
        "kind": "command",
        "label": "Install for Windows x64",
        "command": "npm install -g opencode-ai"
      },
      {
        "os": "windows",
        "arch": "arm64",
        "kind": "command",
        "label": "Install for Windows ARM64",
        "command": "npm install -g opencode-ai"
      }
    ]
  },
