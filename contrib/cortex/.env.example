# Local Tytus Cortex env.
#
# Auto-generated by `tytus cortex up` on first install — you should not need
# to edit this by hand. If you do, secrets must be high-entropy random and
# match what tytus stores in state.json (otherwise the tray daemon and
# Cortex will reject each other's auth).

# Postgres superuser password. Random per-install.
POSTGRES_PASSWORD=

# Cortex AES key for at-rest encryption of user-stored API keys.
# Generate: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=

# Service-to-service shared secret between the tray daemon and local Cortex.
# Daemon presents it as `Authorization: Bearer` on `/tytus/chat` calls.
# NEVER user-visible. Mirrored in state.json.
# Generate: `openssl rand -hex 32`
INTERNAL_SERVICE_TOKEN=

# Pinned image tag. Bumped via `tytus cortex upgrade`.
CORTEX_IMAGE_TAG=2026-05-17

# Host port. Override via `tytus cortex up --port`.
CORTEX_HOST_PORT=8098

# Optional fallback AIL API key. Most users leave this empty since
# SwitchAILocal handles per-request auth locally.
SWITCH_AI_API_KEY=
